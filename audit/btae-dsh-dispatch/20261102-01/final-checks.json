[
  {
    "name": "final-test",
    "command": [
      "cargo",
      "test",
      "--all-targets",
      "--locked",
      "--offline",
      "-j",
      "2",
      "--",
      "--test-threads=4"
    ],
    "exit_code": 0
  },
  {
    "name": "final-clippy",
    "command": [
      "cargo",
      "clippy",
      "--all-targets",
      "--locked",
      "--offline",
      "--",
      "-D",
      "warnings"
    ],
    "exit_code": 0
  },
  {
    "name": "final-fmt",
    "command": [
      "cargo",
      "fmt",
      "--all",
      "--check"
    ],
    "exit_code": 0
  },
  {
    "name": "final-ready",
    "command": [
      "cargo",
      "run",
      "--locked",
      "--offline",
      "--",
      "check-ready",
      "datasets/pilot.json"
    ],
    "exit_code": 1
  }
]
