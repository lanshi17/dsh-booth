 /** Run startup checks through DSH's worker subprocess service with worker shims removed from PATH so a `gh` wrapper script reaches the real binary. */
 export function workerProbe(subprocess: SubprocessRuntime, stateDir: string, cwd: string, signal: AbortSignal): Probe {
   const path = withoutDirectory(process.env.PATH ?? '', workerBin(stateDir))
-  return argv => runAsWorker(subprocess, ['env', `PATH=${path}`, ...argv], cwd, AbortSignal.any([signal, AbortSignal.timeout(60_000)]))
+  return (argv, cancel) => runAsWorker(subprocess, ['env', `PATH=${path}`, ...argv], cwd, AbortSignal.any([signal, AbortSignal.timeout(60_000), ...(cancel ? [cancel] : [])]))
 }

 const GithubUser = z.object({ login: z.string().regex(/^[A-Za-z0-9-]+$/), id: z.number().int().positive() })
@@ -92,17 +92,24 @@ export async function resolveDeployment(machine: Machine, github: unknown, probe
   if (!accounts.cli) throw new SetupError('agentCliUnset')
   let cli: string
   try { cli = executable(accounts.cli, path, workerBin(stateDir)) } catch (error) { throw new SetupError('agentCliMissing', { output: reason(error) }) }
-  const text = await probe([cli, 'api', 'user']).catch((error: unknown) => { throw new SetupError('agentCliSignedOut', { output: reason(error) }) })
-  const agent = parsed(GithubUser, text)
-  if (!agent) throw new SetupError('agentCliNoAccount')
-  // Use the canonical repository name returned by GitHub so renamed repositories match incoming notifications.
-  const access = parsed(RepositoryAccess, await probe([cli, 'api', `repos/${remote}`, '--jq', '{name: .full_name, push: .permissions.push}']).catch((error: unknown) => {
-    throw new SetupError('repositoryUnreadable', { account: agent.login, repository: remote, output: reason(error) })
-  }))
-  if (!access) throw new SetupError('repositoryUnreported', { repository: remote })
-  const repository = access.name
-  if (access.push !== true) throw new SetupError('repositoryReadOnly', { account: agent.login, repository })
-  return { ...machine, repository, github: { cli, login: agent.login, noreply: `${agent.id}+${agent.login}@users.noreply.github.com` } }
+  // Both calls are read-only and use the same CLI account. Keep errors in their original
+  // priority order; abort the speculative repository probe if account validation fails.
+  const cancel = new AbortController()
+  const user = probe([cli, 'api', 'user']).catch((error: unknown) => { throw new SetupError('agentCliSignedOut', { output: reason(error) }) })
+  const repository = probe([cli, 'api', `repos/${remote}`, '--jq', '{name: .full_name, push: .permissions.push}'], cancel.signal)
+    .then(text => ({ ok: true as const, text }), (error: unknown) => ({ ok: false as const, error }))
+  try {
+    const agent = parsed(GithubUser, await user)
+    if (!agent) throw new SetupError('agentCliNoAccount')
+    const result = await repository
+    if (!result.ok) throw new SetupError('repositoryUnreadable', { account: agent.login, repository: remote, output: reason(result.error) })
+    const access = parsed(RepositoryAccess, result.text)
+    if (!access) throw new SetupError('repositoryUnreported', { repository: remote })
+    if (access.push !== true) throw new SetupError('repositoryReadOnly', { account: agent.login, repository: access.name })
+    return { ...machine, repository: access.name, github: { cli, login: agent.login, noreply: `${agent.id}+${agent.login}@users.noreply.github.com` } }
+  } finally {
+    cancel.abort()
+  }
 }

 const AuthStatus = z.object({ appId: z.string().regex(/^cli_[A-Za-z0-9]+$/), brand: z.enum(['feishu', 'lark']).default('feishu'), identities: z.object({ bot: z.object({ status: z.string() }) }) })
@@ -117,15 +124,29 @@ export async function resolveFeishuBot(machine: Machine, feishu: unknown, probe:
   const fail = (error: unknown): never => { throw error instanceof SetupError ? error : new SetupError('feishuCliFailed', { output: reason(error) }) }
   let cli = ''
   try { cli = executable(name, path, workerBin(machine.stateDir)) } catch (error) { fail(error) }
-  const run = (...args: string[]): Promise<string> => probe(['env', 'LARKSUITE_CLI_NO_UPDATE_NOTIFIER=1', 'LARKSUITE_CLI_NO_SKILLS_NOTIFIER=1', cli, ...args]).catch(fail)
-  const text = await run('auth', 'status')
+  const run = (signal: AbortSignal | undefined, ...args: string[]): Promise<string> => probe(['env', 'LARKSUITE_CLI_NO_UPDATE_NOTIFIER=1', 'LARKSUITE_CLI_NO_SKILLS_NOTIFIER=1', cli, ...args], signal).catch(fail)
+  const text = await run(undefined, 'auth', 'status')
   const status = parsed(AuthStatus, text.slice(text.indexOf('{')))
   if (!status) return fail(new SetupError('feishuNoApp'))
   if (status.identities.bot.status !== 'ready') fail(new SetupError('feishuBotNotReady', { app: status.appId, status: status.identities.bot.status }))
-  const mode = /strict-mode:\s*(\w+)/.exec(await run('config', 'strict-mode'))?.[1]
-  if (mode !== 'bot') fail(new SetupError('feishuUserIdentity', { mode: mode ?? 'unknown' }))
-  // `--format json` unwraps only `data`, whereas this endpoint returns the payload under `bot`.
-  const info = parsed(BotInfo, (await run('api', 'GET', '/open-apis/bot/v3/info', '--as', 'bot', '--format', 'ndjson')).split('\n')[0] ?? '')
-  if (!info) return fail(new SetupError('feishuNoBot'))
-  return { cli, appId: status.appId, brand: status.brand, botId: info.bot.open_id, name: info.bot.app_name }
+  // Strict mode and bot metadata are independent reads after auth. Preserve strict-mode's
+  // error precedence while cancelling the metadata request when it cannot be used.
+  const cancel = new AbortController()
+  const modeCheck = run(cancel.signal, 'config', 'strict-mode').then(text => ({ ok: true as const, text }), error => ({ ok: false as const, error }))
+  const botCheck = run(cancel.signal, 'api', 'GET', '/open-apis/bot/v3/info', '--as', 'bot', '--format', 'ndjson')
+    .then(text => ({ ok: true as const, text }), error => ({ ok: false as const, error }))
+  try {
+    const modeResult = await modeCheck
+    if (!modeResult.ok) return fail(modeResult.error)
+    const mode = /strict-mode:\s*(\w+)/.exec(modeResult.text)?.[1]
+    if (mode !== 'bot') fail(new SetupError('feishuUserIdentity', { mode: mode ?? 'unknown' }))
+    // `--format json` unwraps only `data`, whereas this endpoint returns the payload under `bot`.
+    const infoResult = await botCheck
+    if (!infoResult.ok) return fail(infoResult.error)
+    const info = parsed(BotInfo, infoResult.text.split('\n')[0] ?? '')
+    if (!info) return fail(new SetupError('feishuNoBot'))
+    return { cli, appId: status.appId, brand: status.brand, botId: info.bot.open_id, name: info.bot.app_name }
+  } finally {
+    cancel.abort()
+  }
 }
diff --git a/tests/deployment.spec.ts b/tests/deployment.spec.ts
index 532b40b..fe58fd8 100644
--- a/tests/deployment.spec.ts
+++ b/tests/deployment.spec.ts
@@ -99,3 +99,65 @@ describe('setup', () => {
     await refuses('feishuCliFailed', { output: expect.stringContaining('not configured') })
   })
 })
+
+
+it('starts independent GitHub checks together and keeps their results', async () => {
+  const calls: string[] = []
+  let answerUser!: (value: string) => void, answerRepo!: (value: string) => void
+  const pending = resolveDeployment(machine(), { repository: 'acme/widgets', cli: 'gh' }, argv => {
+    calls.push(argv[2] ?? '')
+    return new Promise<string>(resolve => { if (argv[2] === 'user') answerUser = resolve; else answerRepo = resolve })
+  }, path)
+  expect(calls).toEqual(['user', 'repos/acme/widgets'])
+  answerRepo('{"name":"acme/widgets","push":true}')
+  answerUser('{"login":"Agent-Bot","id":7}')
+  expect(await pending).toMatchObject({ repository: 'acme/widgets', github: { login: 'Agent-Bot' } })
+})
+
+it('cancels the repository check and keeps account errors first', async () => {
+  let cancelled = false
+  const pending = resolveDeployment(machine(), { repository: 'acme/widgets', cli: 'gh' }, (argv, signal) => {
+    if (argv[2] === 'user') return Promise.reject(new Error('signed out'))
+    return new Promise<string>((_resolve, reject) => {
+      signal!.addEventListener('abort', () => { cancelled = true; reject(new Error('cancelled')) }, { once: true })
+    })
+  }, path)
+  await expect(pending).rejects.toEqual(setupError('github', 'agentCliSignedOut'))
+  expect(cancelled).toBe(true)
+})
+
+it('keeps account validation errors ahead of an early repository failure', async () => {
+  const pending = resolveDeployment(machine(), { repository: 'acme/widgets', cli: 'gh' }, async argv => {
+    if (argv[2] === 'user') return '{}'
+    throw new Error('repository failed')
+  }, path)
+  await expect(pending).rejects.toEqual(setupError('github', 'agentCliNoAccount'))
+})
+
+
+it('starts Feishu strict-mode and bot checks together after authentication', async () => {
+  const calls: string[] = []
+  let answerMode!: (value: string) => void, answerInfo!: (value: string) => void
+  const pending = resolveFeishuBot(machine(), { cli: 'lark-cli' }, argv => {
+    if (argv.includes('auth')) return Promise.resolve(JSON.stringify({ appId: 'cli_bot', brand: 'feishu', identities: { bot: { status: 'ready' } } }))
+    calls.push(argv.join(' '))
+    return new Promise<string>(resolve => { if (argv.includes('strict-mode')) answerMode = resolve; else answerInfo = resolve })
+  }, path)
+  await new Promise(resolve => setTimeout(resolve, 0))
+  expect(calls.some(call => call.includes('strict-mode'))).toBe(true)
+  expect(calls.some(call => call.includes('/open-apis/bot/v3/info'))).toBe(true)
+  answerInfo('{"bot":{"open_id":"ou_bot","app_name":"Bot"}}')
+  answerMode('strict-mode: bot (source: profile)')
+  await expect(pending).resolves.toMatchObject({ appId: 'cli_bot', botId: 'ou_bot' })
+})
+
+it('cancels Feishu bot metadata when strict-mode fails', async () => {
+  let cancelled = false
+  const pending = resolveFeishuBot(machine(), { cli: 'lark-cli' }, (argv, signal) => {
+    if (argv.includes('auth')) return Promise.resolve(JSON.stringify({ appId: 'cli_bot', brand: 'feishu', identities: { bot: { status: 'ready' } } }))
+    if (argv.includes('strict-mode')) return Promise.reject(new Error('strict mode unavailable'))
+    return new Promise<string>((_resolve, reject) => { signal!.addEventListener('abort', () => { cancelled = true; reject(new Error('cancelled')) }, { once: true }) })
+  }, path)
+  await expect(pending).rejects.toEqual(setupError('feishu', 'feishuCliFailed'))
+  expect(cancelled).toBe(true)
+})
