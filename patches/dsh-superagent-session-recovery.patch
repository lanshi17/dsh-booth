+
+function missingSessionQuery(error: unknown, sessionId: string): boolean {
+  if (!error || typeof error !== 'object') return false
+  const remote = error as { code?: unknown; message?: unknown }
+  return remote.code === 'gateway/internal' && typeof remote.message === 'string'
+    && remote.message.includes(`resume failed for session "${sessionId}"`)
+    && remote.message.includes(`SessionQueryError: session "${sessionId}" not found`)
+}
