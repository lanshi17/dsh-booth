+/**
+ * Announce this plugin as a component instead of making booth inspect DSH internals. The
+ * supervisor is optional for source-level DSH runs; booth supplies all three variables when it
+ * owns the process. A lease means a crashed component disappears without a shutdown callback.
+ */
+function componentRegistration(ctx: Context) {
+  const supervisor = process.env.BOOTH_SUPERVISOR_URL?.replace(/\/$/, '')
+  const token = process.env.BOOTH_SUPERVISOR_TOKEN
+  const id = process.env.BOOTH_COMPONENT_ID
+  const apiUrl = process.env.BOOTH_COMPONENT_API ?? (ctx.webServer ? `http://127.0.0.1:${ctx.webServer.port}` : '')
+  let timer: ReturnType<typeof setInterval> | undefined
+  let registered = false
+  const post = async (path: string): Promise<void> => {
+    if (!supervisor || !token || !id) return
+    const response = await fetch(`${supervisor}${path}`, {
+      method: 'POST',
+      headers: { 'content-type': 'application/json', 'x-booth-supervisor-token': token },
+      body: '{}',
+      signal: AbortSignal.timeout(2_000),
+    })
+    if (!response.ok) throw new Error(`supervisor returned HTTP ${response.status}`)
+  }
+  return {
+    async start(): Promise<void> {
+      if (!supervisor || !token || !id) return
+      const response = await fetch(`${supervisor}/supervisor/v1/components/register`, {
+        method: 'POST',
+        headers: { 'content-type': 'application/json', 'x-booth-supervisor-token': token },
+        body: JSON.stringify({ id, pid: process.pid, apiUrl, version: name }),
+        signal: AbortSignal.timeout(5_000),
+      })
+      if (!response.ok) throw new Error(`supervisor returned HTTP ${response.status}`)
+      registered = true
+      timer = setInterval(() => { void post(`/supervisor/v1/components/${encodeURIComponent(id)}/heartbeat`).catch(error => ctx.logger.warn('dsh-superagent supervisor heartbeat failed: %s', String(error))) }, 5_000)
+      timer.unref?.()
+    },
+    async stop(): Promise<void> {
+      if (timer) clearInterval(timer)
+      timer = undefined
+      if (!registered) return
+      registered = false
+      try { await post(`/supervisor/v1/components/${encodeURIComponent(id!)}/unregister`) }
+      catch (error) { ctx.logger.warn('dsh-superagent supervisor unregister failed: %s', String(error)) }
+    },
+  }
+}
 export type { Deployment, DeploymentConfig } from './deployment.ts'
 export * from './core/index.ts'
